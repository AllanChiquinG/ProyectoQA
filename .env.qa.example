# Valores de EJEMPLO del ambiente QA (docker-compose.yml + docker-compose.qa.yml). Se copia a .env.qa (ignorado por Git) con
# "scripts/qa.sh init", que genera contraseñas aleatorias. No usar estos valores fuera de tu máquina. Sin secretos reales aquí.
COMPOSE_PROJECT_NAME=medicore-qa
IMAGE_TAG=local

# Dependencias (las usa el docker-compose.yml base)
POSTGRES_DB=medicore
POSTGRES_USER=medicore
POSTGRES_PASSWORD=cambiar-con-qa-sh-init
REDIS_PASSWORD=cambiar-con-qa-sh-init
RABBITMQ_DEFAULT_USER=medicore
RABBITMQ_DEFAULT_PASS=cambiar-con-qa-sh-init

# Aplicación
JWT_SIGNING_KEY=cambiar-con-qa-sh-init-minimo-32-caracteres
CLINIC_TIMEZONE=America/Guatemala
# Límite de inicios de sesión por minuto y por IP (la API de producción usa 10).
AUTH_PERMITS_PER_MINUTE=10
# Solo para el contenedor "seed" (usuarios ficticios de QA); se puede borrar después de sembrar.
SEED_DEV_PASSWORD=cambiar-con-qa-sh-init

# Proxy inverso. Local: HTTP en 127.0.0.1:8080. Azure: SITE_ADDRESS=<nombre DNS> y binds 0.0.0.0 (los pone Ansible).
SITE_ADDRESS=:80
PROXY_HTTP_BIND=127.0.0.1:8080
PROXY_HTTPS_BIND=127.0.0.1:8443
