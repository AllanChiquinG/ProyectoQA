<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage x:Class="MediCore.Mobile.Pages.SlotsPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:MediCore.Mobile.Views"
             xmlns:vm="clr-namespace:MediCore.Mobile.Core.ViewModels;assembly=MediCore.Mobile.Core"
             Title="Fecha y horario">
    <ContentPage.Resources>
        <views:StringNotEmptyConverter x:Key="NotEmpty" />
    </ContentPage.Resources>
    <ScrollView>
        <VerticalStackLayout>
            <views:HeaderBar ShowBack="True" />
            <VerticalStackLayout Padding="24,8,24,24" Spacing="8">
                <Label Text="MOB-05 · PACIENTE" Style="{StaticResource Eyebrow}" />
                <Label Text="Fecha y horario" Style="{StaticResource Title}" />
                <Label Text="Paso 2 de 3 · Disponibilidad" Style="{StaticResource Sub}" />

                <Border Style="{StaticResource CardBorder}">
                    <VerticalStackLayout>
                        <Label Text="{Binding DoctorName}" Style="{StaticResource CardTitle}" AutomationId="medico_elegido" />
                        <Label Text="{Binding DoctorSpecialty}" Style="{StaticResource CardText}" />
                    </VerticalStackLayout>
                </Border>

                <Label Text="Fecha" Margin="0,10,0,0" />
                <DatePicker x:Name="DatePick" DateSelected="OnDateSelected" AutomationId="selector_fecha" SemanticProperties.Description="Fecha de la cita" />

                <Label Text="Horarios disponibles" Style="{StaticResource CardTitle}" Margin="0,12,0,0" />
                <ActivityIndicator IsRunning="{Binding SlotsLoading}" IsVisible="{Binding SlotsLoading}" Color="{StaticResource Green}" />
                <Label Text="{Binding SlotsMessage}" Style="{StaticResource Sub}" TextColor="{StaticResource DangerText}" IsVisible="{Binding SlotsMessage, Converter={StaticResource NotEmpty}}" AutomationId="mensaje_horarios" />

                <FlexLayout BindableLayout.ItemsSource="{Binding Slots}" Wrap="Wrap" JustifyContent="Start">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:SlotItem">
                            <Button Text="{Binding Time}" WidthRequest="84" Margin="0,0,10,10" FontSize="14" BorderWidth="1" BorderColor="{StaticResource SlotBorder}"
                                    BackgroundColor="{StaticResource SlotBackground}" TextColor="{StaticResource SecondaryText}" AutomationId="boton_horario"
                                    IsEnabled="{Binding Available}"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:BookingViewModel}}, Path=SelectTimeCommand}" CommandParameter="{Binding .}">
                                <Button.Triggers>
                                    <DataTrigger TargetType="Button" Binding="{Binding Available}" Value="False">
                                        <Setter Property="BackgroundColor" Value="{StaticResource SlotDisabled}" />
                                        <Setter Property="TextColor" Value="{StaticResource SlotDisabledText}" />
                                    </DataTrigger>
                                    <DataTrigger TargetType="Button" Binding="{Binding IsSelected}" Value="True">
                                        <Setter Property="BackgroundColor" Value="{StaticResource Green}" />
                                        <Setter Property="TextColor" Value="White" />
                                    </DataTrigger>
                                </Button.Triggers>
                            </Button>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </FlexLayout>

                <Label Text="{Binding TimeError}" Style="{StaticResource ErrorText}" IsVisible="{Binding TimeError, Converter={StaticResource NotEmpty}}" AutomationId="error_horario" />
                <Button Text="Continuar →" Command="{Binding ContinueCommand}" Margin="0,18,0,0" AutomationId="boton_continuar" />
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
