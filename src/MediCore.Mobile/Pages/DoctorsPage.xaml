<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage x:Class="MediCore.Mobile.Pages.DoctorsPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:MediCore.Mobile.Views"
             xmlns:vm="clr-namespace:MediCore.Mobile.Core.ViewModels;assembly=MediCore.Mobile.Core"
             Title="Seleccionar médico">
    <ScrollView>
        <VerticalStackLayout>
            <views:HeaderBar ShowBack="True" />
            <VerticalStackLayout Padding="24,8,24,24" Spacing="8">
                <Label Text="MOB-04 · PACIENTE" Style="{StaticResource Eyebrow}" />
                <Label Text="Selecciona tu médico" Style="{StaticResource Title}" />
                <Label Text="Paso 1 de 3 · Profesional" Style="{StaticResource Sub}" />

                <views:StateBanner />

                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Doctors}" IsVisible="{Binding IsContent}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:DoctorItem">
                            <Border Style="{StaticResource CardBorder}" AutomationId="tarjeta_medico">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:BookingViewModel}}, Path=SelectDoctorCommand}" CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <VerticalStackLayout Spacing="6">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                        <Border BackgroundColor="#CCE8E0" StrokeShape="RoundRectangle 20" StrokeThickness="0" WidthRequest="40" HeightRequest="40">
                                            <Label Text="{Binding Initials}" FontAttributes="Bold" TextColor="#245D57" HorizontalOptions="Center" VerticalOptions="Center" />
                                        </Border>
                                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                            <Label Text="{Binding FullName}" Style="{StaticResource CardTitle}" />
                                            <Label Text="{Binding Specialty}" Style="{StaticResource CardText}" />
                                        </VerticalStackLayout>
                                    </Grid>
                                    <Button Text="Seleccionar →" Style="{StaticResource LinkButton}" AutomationId="boton_seleccionar_medico"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:BookingViewModel}}, Path=SelectDoctorCommand}" CommandParameter="{Binding .}" />
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
