{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Messaging": {
    "Enabled": true,
    "PublishPollInterval": "00:00:02",
    "PublishBatchSize": 20,
    "PublishMaxBackoff": "00:00:30",
    "ConsumerMaxAttempts": 4,
    "ConsumerRetryDelay": "00:00:10",
    "ConsumerReconnectDelay": "00:00:05"
  }
}
