@page
@using System.Security.Claims
@model IndexModel
@{
    ViewData["Code"] = "INICIO";
    ViewData["Title"] = "Espacio de trabajo";
    ViewData["Subtitle"] = "Tu jornada de atención, en un solo lugar.";
    var firstName = (User.Identity?.Name ?? "").Split(' ', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault();
}

<div class="panel panelpad narrow">
    <h2>Hola, @firstName</h2>
    <p class="sub">Tu sesión está iniciada. Verás aquí los módulos que corresponden a tu rol.</p>
    <div class="notice">Los módulos de trabajo se habilitarán en las próximas entregas.</div>
</div>
