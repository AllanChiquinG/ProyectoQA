@using System.Security.Claims
@using MediCore.Contracts
@{
    Layout = "_Layout";

    var role = User.FindFirstValue(ClaimTypes.Role) ?? "";
    var name = User.Identity?.Name ?? "";
    var initials = string.Concat(name.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(p => p[0]));

    // Navegación por rol, según el diseño. Solo lleva enlace lo que ya está implementado (Section == null).
    (string Icon, string Text, string? Section, string? Target)[] nav = role switch
    {
        Roles.Administrador => [("♧", "Pacientes", "/Pacientes", "/Pacientes/Index"), ("✚", "Médicos", "/Medicos", "/Medicos/Index"), ("⚿", "Usuarios y roles", "/Usuarios", "/Usuarios")],
        Roles.Medico => [("▦", "Mi agenda", "/MiAgenda", "/MiAgenda"), ("♧", "Pacientes autorizados", "/Pacientes", "/Pacientes/Index")],
        Roles.Laboratorio => [("⚗", "Resultados de laboratorio", null, null)],
        _ => [("▦", "Agenda de citas", "/Agenda", "/Agenda/Index"), ("♧", "Pacientes", "/Pacientes", "/Pacientes/Index")],
    };
    var currentPage = ViewContext.RouteData.Values["page"] as string ?? "";
    var roleText = Roles.Mostrar(role);
    var actionText = ViewData["ActionText"] as string;
    var actionUrl = ViewData["ActionUrl"] as string ?? (ViewData["ActionPage"] is string actionPage ? Url.Page(actionPage) : null);
}

<div class="layout">
    <aside>
        <div class="brand"><span class="cross">+</span><div>MediCore<small>ATENCIÓN CONECTADA</small></div></div>
        <div class="navlabel">ESPACIO DE TRABAJO</div>
        <nav aria-label="Navegación principal">
            @foreach (var item in nav)
            {
                if (item.Section is null)
                {
                    <span class="nav disabled" aria-disabled="true" title="Disponible en próximas entregas"><i aria-hidden="true">@item.Icon</i>@item.Text</span>
                }
                else
                {
                    var active = currentPage == item.Section || currentPage.StartsWith(item.Section + "/");
                    <a href="@Url.Page(item.Target)" class="nav @(active ? "active" : "")" aria-current="@(active ? "page" : null)"><i aria-hidden="true">@item.Icon</i>@item.Text</a>
                }
            }
        </nav>
        <div class="sidebottom">
            <div class="notice">Una atención más cercana.<br>Un equipo mejor conectado.</div>
            <p>Proyecto 2 · MediCore</p>
            <form method="post" asp-page="/Logout">
                <button class="link" type="submit"><span aria-hidden="true">↪</span> Cerrar sesión</button>
            </form>
        </div>
    </aside>
    <main class="main">
        <header>
            <div class="crumb">MediCore &nbsp; / &nbsp; <strong>@ViewData["Title"]</strong></div>
            <div class="user">
                <div class="avatar" aria-hidden="true">@initials</div>
                <div>@name<small>@roleText</small></div>
            </div>
        </header>
        <div class="content">
            <div class="eyebrow">@ViewData["Code"] &nbsp; / &nbsp; @roleText.ToUpperInvariant()</div>
            <div class="titlebar">
                <div>
                    <h1>@ViewData["Title"]</h1>
                    <p class="sub">@ViewData["Subtitle"]</p>
                </div>
                @if (actionText is not null && actionUrl is not null)
                {
                    <a class="btn" href="@actionUrl">＋ @actionText</a>
                }
            </div>
            @RenderBody()
        </div>
    </main>
</div>

@section Scripts {
    @await RenderSectionAsync("Scripts", required: false)
}
