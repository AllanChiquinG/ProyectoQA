<Project Sdk="Microsoft.NET.Sdk.Worker">

  <!--
    Proceso de mensajería (sin HTTP): publicador del outbox y consumidor de notificaciones (RabbitMQ).
    Es el mismo código de MediCore.Infrastructure que en desarrollo corre dentro de la API; en contenedores se separa para poder
    reiniciarlo y escalarlo aparte (la API se despliega con Messaging__Enabled=false).
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
    <ProjectReference Include="..\MediCore.Infrastructure\MediCore.Infrastructure.csproj" />
  </ItemGroup>

</Project>
